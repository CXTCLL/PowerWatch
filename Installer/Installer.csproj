<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PowerWatch-Setup</AssemblyName>
    <RootNamespace>Installer</RootNamespace>
    <Version>1.1.0</Version>
    <Product>PowerWatch 安装程序</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PowerWatch\AppPaths.cs" Link="AppPaths.cs" />
    <Compile Include="..\PowerWatch\Dpi.cs" Link="Dpi.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\build\app\PowerWatch.exe">
      <LogicalName>Payload.PowerWatch.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\build\app\PowerWatch.dll">
      <LogicalName>Payload.PowerWatch.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\build\app\PowerWatch.deps.json">
      <LogicalName>Payload.PowerWatch.deps.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\build\app\PowerWatch.runtimeconfig.json">
      <LogicalName>Payload.PowerWatch.runtimeconfig.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
